import {
  "gaato/mttp",
  "gaato/mttp/runtime",
  "gaato/mttp_core",
  "gaato/mttp_core/client",
  "gaato/mttp_core/h1client",
  "gaato/mttp_core/multipart",
  "gaato/mttp_core/rt",
  "gaato/mttp_core/sse",
  "gaato/mttp_digest",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

import {
  "gaato/mttp_core/client" @mttp_core_client,
  "moonbitlang/core/async",
} for "test"

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "native+wasm+js"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
